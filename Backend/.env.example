# ==============================================================================
# 🏥 MedFlowAI — Backend Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# Local MongoDB or MongoDB Atlas connection string
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/MyDB

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SESSIONS
# Secure secret key used to sign HttpOnly session cookies
# ------------------------------------------------------------------------------
JWT_SECRET=medflowai_ultra_secure_jwt_secret_2026
COOKIE_NAME=mycookie

# ------------------------------------------------------------------------------
# 4. GROQ API (LLM Inference — SOAP Notes, Digital Twin, Document Generation)
# Get your free API key at: https://console.groq.com/
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI (Vector Embeddings for Knowledge Retrieval)
# Get your free API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 6. QDRANT VECTOR DATABASE (Clinic SOP Knowledge Base)
# Get a free cloud cluster at: https://cloud.qdrant.io/
# Local fallback default: http://localhost:6333
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=clinic_knowledge_base

# ------------------------------------------------------------------------------
# 7. CLOUDINARY (Raw Hospital Document Archival)
# Get free account credentials at: https://cloudinary.com/
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 8. BREVO SMTP EMAIL (Optional: Verification & Password Reset OTPs)
# Get SMTP credentials from: https://app.brevo.com/ (SMTP & API section)
# If left blank, OTP emails are safely bypassed in local development
# ------------------------------------------------------------------------------
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# ------------------------------------------------------------------------------
# 9. ADMIN SEED CONFIGURATION (Optional: Used by scripts/seedAdmin.js)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@medflow.demo
ADMIN_PASSWORD=Admin@123
